---
import '../styles/global.css';

const { title, language = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang={language} dir={language === 'fa' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#faf8f5" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-paper font-sans text-ink antialiased">
    <header class="border-b border-line">
      <nav dir="ltr" lang="en" aria-label="Navigation" class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-5 sm:px-8">
        <a href={base} class="inline-flex items-center gap-3 font-display text-xl leading-tight">
          <span aria-hidden="true" class="grid size-9 shrink-0 place-items-center rounded-full bg-plum font-sans text-sm font-semibold text-white">ZZ</span>
          Dr. Zahra Zabihi
        </a>
        <a href={base + 'admin/'} class="rounded-full border border-line px-4 py-2 text-sm font-medium text-plum transition-colors hover:bg-blush">Editor</a>
      </nav>
    </header>
    <main class="flex-1"><slot /></main>
    <footer class="border-t border-line">
      <div dir="ltr" lang="en" class="mx-auto flex max-w-6xl flex-wrap justify-between gap-3 px-5 py-6 text-sm text-muted sm:px-8">
        <span>Dr. Zahra Zabihi</span>
        <span>Article publishing demo</span>
      </div>
    </footer>
  </body>
</html>
