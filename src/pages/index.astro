---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const articles = (await getCollection('articles')).sort((a, b) => a.id.localeCompare(b.id));
const base = import.meta.env.BASE_URL;
---
<Layout title="Article publishing demo">
  <h1>Articles</h1>
  {articles.map(({ id, data }) => (
    <article class="entry" lang={data.language} dir={data.language === 'fa' ? 'rtl' : 'ltr'}>
      <h2><a href={base + 'articles/' + encodeURIComponent(id) + '/'}>{data.title}</a></h2>
      <p class="summary">{data.description}</p>
    </article>
  ))}
</Layout>
